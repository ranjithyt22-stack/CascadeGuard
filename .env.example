# CascadeGuard AI — Environment Configuration & API Credentials
# Copy this file to .env for local credentials (do NOT commit .env to version control)

# Flask Server Port & Environment
PORT=5050
FLASK_ENV=production
DEBUG=false

# Open-Meteo Weather API
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# Industrial Transformer SCADA API Adapter (Optional)
TRANSFORMER_API_URL=
TRANSFORMER_API_KEY=

# HVAC Chiller BMS API Adapter (Optional)
CHILLER_API_URL=
CHILLER_API_KEY=

# Water Pump Telemetry API Adapter (Optional)
WATER_PUMP_API_URL=
WATER_PUMP_API_KEY=
